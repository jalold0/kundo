{
  "expo": {
    "name": "Kundo",
    "slug": "kundo",
    "owner": "jalold0",
    "scheme": "kundo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#1D3F91",
    "backgroundColor": "#E9E3D7",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "online.buxoro.kundo",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "Kundo",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "online.buxoro.kundo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1D3F91",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#E9E3D7",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#111319"
          }
        }
      ],
      "expo-font",
      "expo-document-picker",
      "expo-sharing",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "d915e71a-8916-4e23-9bb4-46c38ec6f90f"
      }
    }
  }
}
